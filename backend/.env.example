# NetScope startup settings. Copy to backend/.env to use; every line is optional.
# Settings you change in the UI are stored in the database, not here.

# SQLite database file. Relative paths are resolved against the working directory.
# Keep it on a local disk (WAL mode does not work reliably on network shares).
NETSCOPE_DATABASE_PATH=data/netscope.db

# Address for `uv run python -m app`. Use 0.0.0.0 to listen on all interfaces.
NETSCOPE_HOST=127.0.0.1
NETSCOPE_PORT=8000

# Built frontend served by the backend (run `npm run build` in frontend/ first).
NETSCOPE_FRONTEND_DIST=../frontend/dist

# DEBUG, INFO, WARNING or ERROR
NETSCOPE_LOG_LEVEL=INFO

# First-run setup. Without an admin, NetScope prints a random one-time setup token to the log.
# NETSCOPE_SETUP_TOKEN=at-least-20-characters-long
# Or create the admin directly on first boot (password: at least 20 characters):
# NETSCOPE_ADMIN_USERNAME=admin
# NETSCOPE_ADMIN_PASSWORD=

# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted
# (comma-separated IP addresses or networks such as 172.17.0.0/16; "*" is refused).
# Needed for the Secure cookie behind Tailscale Serve.
NETSCOPE_TRUSTED_PROXIES=127.0.0.1

# Extra host names NetScope answers to (comma-separated; ".example.org" covers every name under
# it). IP addresses, localhost, single-word names and .local / .home.arpa / .internal / .ts.net
# names always work.
# NETSCOPE_ALLOWED_HOSTS=homeserver.fritz.box
