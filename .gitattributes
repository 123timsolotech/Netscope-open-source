# Normalize all text files to LF in the repository and working tree,
# so Windows and Linux checkouts behave the same (shell scripts, Docker, CI).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
