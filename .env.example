# Settings for `docker compose` (copy to .env next to docker-compose.yml; every line is
# optional). Settings you change in the app are stored in its database, not here.
# Values with $, # or spaces in them go in single quotes ('...').
# Running without Docker? Use backend/.env.example instead.

# Where the port is published on this computer: "8000" (the LAN, http://<this-computer>:8000)
# or "127.0.0.1:8000" (only this computer, for Tailscale Serve).
# NETSCOPE_PUBLISH=8000

# Extra host names NetScope answers to, comma-separated (".example.org" covers every name under
# it). IP addresses, localhost, single-word names (homeserver) and .local / .home.arpa /
# .internal / .ts.net names always work.
# NETSCOPE_ALLOWED_HOSTS=homeserver.fritz.box

# Behind Tailscale Serve only: trust the Docker network's gateway as the proxy.
# NETSCOPE_TRUSTED_PROXIES=172.30.240.1

# DEBUG, INFO, WARNING or ERROR
# NETSCOPE_LOG_LEVEL=INFO

# First start: without an admin, NetScope prints a one-time setup token to the log
# (docker compose logs netscope). Or create the admin right away with a password of at least
# 20 characters, in single quotes ('...'). Afterwards delete the line and run
# `docker compose up -d` again (docs/deployment.md, section 2).
# NETSCOPE_ADMIN_USERNAME=admin
# NETSCOPE_ADMIN_PASSWORD=
